# Auto normalize line endings
* text=auto

# Python files
*.py text eol=lf
*.pyc binary

# SQL files
*.sql text eol=lf

# Data files
*.csv text eol=lf
*.json text eol=lf

# Configuration
*.env text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary files
*.pickle binary
*.pkl binary

# Git attributes for language detection
*.sql linguist-language=SQL
*.sql linguist-detectable=true